# --- Core ---
APP_ENV=development            # set to "production" when deployed
SECRET_KEY=change-me-to-a-long-random-string
MONGO_URI=mongodb://localhost:27017
MONGO_DB=home_service_provider
FRONTEND_URL=http://localhost:5173

# --- First admin account (created on startup if it doesn't exist) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Site Admin

# --- Razorpay (leave blank to use the built-in DEMO payment mode in development) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Business rules ---
PLATFORM_FEE_PERCENT=15        # share the platform keeps from each completed job

# --- Password-reset email (optional; without SMTP the reset link is printed to the server console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Home Service Provider <no-reply@example.com>
